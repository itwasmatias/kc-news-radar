[Unit]
Description=Kansas City News Radar local pilot
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@WORKING_DIRECTORY@
EnvironmentFile=%h/.config/kc-news-radar/pilot.env
Environment=PYTHONUNBUFFERED=1
ExecStart=@PYTHON@ -m kc_news_radar.scheduler
Restart=on-failure
RestartSec=15s
TimeoutStopSec=315s
KillSignal=SIGTERM

[Install]
WantedBy=default.target
